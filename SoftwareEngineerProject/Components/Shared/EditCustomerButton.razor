@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<button @onclick="Logout" class="btn btn-outline-primary">Edit Profile</button>

@code {
	[Parameter]
	public int Id { get; set; }

	[Parameter]
	public string Name { get; set; }

	void Logout()
	{
		NavigationManager.NavigateTo($"/edit-customer/{Name}/{Id}");
	}
}
