@if (Visible == true) {
	<div class="alert @Type">
		<span>@Text</span>
		<button class="btn-close" style="float:right" @onclick="HideAlert"></button>
	</div>
}

@code {
	[Parameter]
	public string Text { get; set; }

	public bool Visible { get; set; }
	public string Type { get; set; }

	public void ShowSuccessText(string successText) {
		Type = "alert-success";
		ShowAlert(successText);
	}

	public void ShowErrorText(string successText)
	{
		Type = "alert-danger";
		ShowAlert(successText);
	}

	private void ShowAlert(string errText) {
		Text = errText;
		Visible = true;
		StateHasChanged();
	}

	private void HideAlert() {
		Visible = false;
		StateHasChanged();
	}

}
