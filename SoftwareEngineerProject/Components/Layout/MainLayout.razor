@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <CascadingAuthenticationState>
                    <AuthorizeView>
                        Hello @email - @role <a href="/logout">Logout</a>

                    </AuthorizeView>
                </CascadingAuthenticationState>
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

<script>
    window.downloadCsvFile = (filename, dataUrl) => {
        const fileLink = document.createElement('a');
        fileLink.href = dataUrl;
        fileLink.download = filename;
        document.body.appendChild(fileLink);
        fileLink.click();
        document.body.removeChild(fileLink);
    }
</script>


@code {
    public string email { get; set; }
    public string role { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity.IsAuthenticated) {
            email = user.Claims.FirstOrDefault(u => u.Type == ClaimTypes.Name)?.Value;
            role = user.Claims.FirstOrDefault(u => u.Type == ClaimTypes.Role)?.Value;
        }

    }

}